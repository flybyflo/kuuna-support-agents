{
  "name": "@kuuna/backend-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "exports": {
    ".": "./src/server.ts"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "dev:worker": "tsx watch --conditions=development src/jobs/worker.ts",
    "db:migrate": "tsx --conditions=development src/db/migrate.ts",
    "serve": "tsx --conditions=development src/server.ts",
    "worker": "tsx --conditions=development src/jobs/worker.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json --customConditions development",
    "test": "node --conditions=development --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@fastify/cors": "^11.0.1",
    "@kuuna/agent-contracts": "workspace:*",
    "@kuuna/contracts": "workspace:*",
    "@kuuna/gateway": "workspace:*",
    "@kuuna/runtime-agent-ts": "workspace:*",
    "@sentry/node": "^10.49.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "bullmq": "^5.65.1",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "openai": "^6.9.1",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0"
  }
}
