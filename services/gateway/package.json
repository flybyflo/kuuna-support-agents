{
  "name": "@kuuna/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "types": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch --conditions=development src/server.ts",
    "serve": "tsx --conditions=development src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json --customConditions development",
    "test": "node --conditions=development --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@kuuna/contracts": "workspace:*",
    "@sentry/node": "^10.49.0",
    "@trpc/client": "^11.7.2",
    "@trpc/server": "^11.7.2",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "fastify": "^5.6.2",
    "pino": "^9.6.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0"
  },
  "exports": {
    "./trpc": {
      "types": "./dist/src/trpc.d.ts",
      "development": "./src/trpc.ts",
      "default": "./dist/src/trpc.js"
    }
  }
}
